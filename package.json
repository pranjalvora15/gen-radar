{
  "name": "genai-updates-platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev:python",
    "dev:python": "npm-run-all --parallel dev:client dev:server:python dev:ai:python",
    "dev:client": "npm --workspace client run dev",
    "dev:server:python": "cross-env AI_SERVICE_URL=http://localhost:8010 npm --workspace server run dev",
    "dev:ai:python": "python -m uvicorn app:app --app-dir ai-service --port 8010",
    "build": "npm --workspace client run build",
    "check": "npm --workspace server run check && npm --workspace client run build && python -m compileall -q ai-service",
    "refresh": "npm --workspace server run refresh"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "npm-run-all": "^4.1.5"
  }
}
